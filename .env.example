# ── Base de datos: Supabase (Postgres) ───────────────────────────────────────
# OBLIGATORIA. En Supabase: Project -> Settings -> Database -> Database settings
# y copia la "URI" del modo Pooler (la de la derecha, puerto 6543).
# Debe verse así (usuario postgres.<ref>, host aws-0-<region>.pooler.supabase.com):
#   postgresql://postgres.<ref>:tu-password@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# Certificado CA de Supabase (opcional pero recomendado en producción).
# Descárgalo en Settings -> Database -> Download CA certificate y pégalo aquí
# (PEM con \n escapados, o en base64). Sin esto la conexión funciona igual,
# pero sin verificar el certificado del servidor.
# SUPABASE_DB_CA_CERT=

# Mínimo de conexiones del pool por instancia (opcional, por defecto 5).
# PG_POOL_MAX=5

# ── Usuario del CRM ──────────────────────────────────────────────────────────
# Nota: si cambias la contraseña desde "Mi empresa" en el CRM, la contraseña
# guardada en la base (no esta variable) pasa a ser la que se usa para entrar.
ADMIN_USER=admin
ADMIN_PASS=

# Secreto para firmar las sesiones (JWT). Genera uno largo y aleatorio:
#   openssl rand -hex 32
JWT_SECRET=

# Opcional: URL de un webhook (n8n, Make, Slack, etc.) que recibe un POST con
# { "source": "codeverything", "lead": {...} } cada vez que entra un lead nuevo.
# Si no se define, los leads solo se ven dentro del CRM.
# LEAD_WEBHOOK_URL=https://tu-webhook.com/codeverything
